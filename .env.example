APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (also set FRONTEND_URL; demo seeders are skipped).
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database connection:
# - Windows (XAMPP): Start MySQL in XAMPP Control Panel. Default user is 'root' with NO password.
# - macOS: Start MySQL via Homebrew (`brew services start mysql@8.4`). Default is also 'root' with empty password.
# Create the database 'sutura' in phpMyAdmin (http://localhost/phpmyadmin) or MySQL CLI before migrating.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sutura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Optional: durable backups and text messages (see docs/DEPLOYMENT-RAILWAY-SUPABASE.md) ---
# BACKUP_DISK=s3                 # upload the daily database dump off the server (e.g. Cloudflare R2); default "local"
# BACKUP_RETENTION_DAYS=30
# SMS_DRIVER=log                 # log = TEST MODE (nothing is delivered). semaphore = real delivery.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=
# SMS_TEST_ALLOWLIST=            # outside production, a real driver only texts these numbers (comma-separated)
# SMS_DAILY_CAP=100              # max texts per shop per day

# --- Optional: keep uploads off the server (Cloudflare R2 = the "s3" disk). Needed on Railway: its disk is wiped on every redeploy. ---
# UPLOAD_DISK=s3                 # public photos (needs a bucket with a public URL: AWS_URL)
# PRIVATE_DISK=s3_private        # shop application documents + subscription receipts (a PRIVATE bucket)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_BUCKET=sutura-uploads
# AWS_URL=https://<your public bucket domain>
# AWS_PRIVATE_BUCKET=sutura-private
